---
import { withBase } from "../lib/base.js";

const links = [
  { href: withBase("biography/"), label: "biography", anagram: "YAH PIG ORB" },
  { href: withBase("projects/"), label: "projects", anagram: "CROP JETS" },
  { href: withBase("blog/"), label: "blog", anagram: "GLOB" },
];
---

<nav class="navigation-bar" aria-label="Primary navigation">
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href}>
          {/* a tap here navigates, so a morph would start and get cut off */}
          <anagram-animator
            into={link.anagram}
            enter-delay="0"
            tabindex="-1"
            ignore-touch
          >
            {link.label}
          </anagram-animator>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .navigation-bar ul {
    font-family: var(--font-display);
    font-size: var(--fontSize-2);
    text-transform: uppercase;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    /* rem, not ch: ch is measured in the (late-loading) display font, which
       made the container width shift on font swap. 41.25rem == the old 55ch. */
    max-width: 41.25rem;
    gap: 2rem;

    @media (max-width: 640) {
      flex-direction: column;
    }
  }

  .navigation-bar a {
    text-decoration: none;
    padding-inline: 0.5rem;
  }

  .navigation-bar a:hover,
  .navigation-bar a:focus-visible {
    color: var(--ink);
  }
</style>
